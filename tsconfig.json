{
  "compilerOptions": {
    "target": "ES2022", "module": "Node16", "moduleResolution": "Node16",
    "outDir": "out", "rootDir": ".", "strict": true,
    "esModuleInterop": true, "skipLibCheck": true, "sourceMap": true,
    "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
